# =============================================================================
# energy_monitor — Development Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before running the dev server.
#
#   cp config/envs/.env.example.dev .env
#
# =============================================================================

# =============================================================================
# DJANGO
# =============================================================================

DJANGO_SETTINGS_MODULE=config.settings.dev

DEBUG=True

# Generate a new key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=insecure-secret-key-replace-as-soon-as-possible

ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated. Required when accessing the dev server from a non-localhost
# origin, e.g. via Cloudflare Tunnel or a local network device.
# Example: http://localhost:8000,https://your-tunnel.trycloudflare.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Email address that receives admin error notifications.
SITE_OWNER=your@gmail.com

# A list of all the people who get code error notifications.
ADMINS="John Doe <john@example.com>, Mary <mary@example.com>"


# =============================================================================
# INTERNALISATION
# =============================================================================

TIME_ZONE=UTC


# =============================================================================
# HEALTH CHECK
# A secret token used to protect the health check endpoint from public access.
# Can be any random string.
# =============================================================================

HEALTH_CHECK_TOKEN=qwerty12345




# =============================================================================
# CORS
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000
