# =============================================================================
# energy_monitor — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before running the production server.
#
#   cp config/envs/.env.example.production .env
#
# =============================================================================

# =============================================================================
# DJANGO
# =============================================================================

DJANGO_SETTINGS_MODULE=config.settings.production

DEBUG=False

# Generate a new key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated.
ALLOWED_HOSTS=

# Comma-separated. Required when accessing the server from a non-localhost
# origin, e.g. via Cloudflare Tunnel or a local network device.
# Example: https://your-tunnel.trycloudflare.com
CSRF_TRUSTED_ORIGINS=

# Email address that receives admin error notifications.
SITE_OWNER=

# A list of all the people who get code error notifications.
# In the form "John Doe <john@example.com>, Mary <mary@example.com>"
ADMINS=


# =============================================================================
# DATABASE
# =============================================================================

DATABASE_URL=


# =============================================================================
# INTERNALISATION
# =============================================================================

TIME_ZONE=UTC


# =============================================================================
# HEALTH CHECK
# A secret token used to protect the health check endpoint from public access.
# Can be any random string.
# =============================================================================

HEALTH_CHECK_TOKEN=




# =============================================================================
# EMAIL
# =============================================================================

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL



# =============================================================================
# CORS
# =============================================================================
CORS_ALLOWED_ORIGINS=
